<?xml version="1.0"?>
<ruleset name="pageguard">
    <description>pageguard 用の PHPCS 設定（WordPress-Extra）。CI では phpcs-changed により PR の差分行にのみ適用する。</description>

    <!-- 対象は追跡されている .php ファイル -->
    <file>.</file>
    <arg name="extensions" value="php"/>

    <!-- 第三者コード（plugin-update-checker）は指摘対象から除外する -->
    <exclude-pattern>*/inc/plugin-update-checker/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>

    <rule ref="WordPress-Extra"/>
</ruleset>
